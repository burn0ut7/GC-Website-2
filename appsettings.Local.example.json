{
  // YOUR PRIVATE LOCAL SETTINGS. Restart the website after editing.
  // appsettings.Local.json is ignored by Git and excluded from published builds.
  // The comments below are supported by the website's JSON config reader.

  "Discord": {
    // Leave false while filling this in. Set true when sign-in is ready to test.
    "Enabled": false,

    // WEBSITE SIGN-IN
    // Discord Developer Portal > your Global Conflicts application > General Information.
    // Application ID identifies the application, NOT your personal Discord account.
    "ClientId": "",

    // Same application > OAuth2 > Client Secret. Keep this private.
    "ClientSecret": "",

    // DEVELOPER ACCESS TO PRIVATE PAGES
    // In Discord: Settings > Advanced > enable Developer Mode to see Copy ID options.
    // Right-click the Global Conflicts server icon > Copy Server ID.
    "GuildId": "",

    // Server Settings > Roles > right-click the Developer role > Copy Role ID.
    // Everyone with this role gets access. There is NO personal user-ID list.
    "DeveloperRoleId": "",

    // Developer Portal > community application > Bot > Token. Keep this private.
    // Used only by our backend to check roles. The bot must already be in the server.
    // Do not reset an existing live bot's token just to fill this in.
    "BotToken": ""
  },

  // WEBSITE DATABASE — not a Discord setting. Leave this for local database setup.
  "ConnectionStrings": { "Gc": "" },

  // Private login-cookie key storage. No need to change this for local testing.
  "Auth": { "KeysPath": ".local/auth-keys" }
}
